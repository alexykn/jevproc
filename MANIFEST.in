include LICENSE README.md ACKNOWLEDGMENTS.md CHANGELOG.md SECURITY.md AGENTS.md pyproject.toml
recursive-include src/jevproc/data *.yaml *.json
recursive-include docs *.md
recursive-include tests *.py
include .github/workflows/ci.yml
include tools/wheel_smoke.py
prune .venv
prune .pytest_cache
prune build
prune dist
global-exclude __pycache__ *.py[cod] *.sqlite3 *.sqlite3-journal .env

include .gitignore .python-version
